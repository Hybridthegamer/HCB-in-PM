# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hcb_monitor
POSTGRES_USER=hcb_user
POSTGRES_PASSWORD=hcb_secure_password
DATABASE_URL=postgresql+asyncpg://hcb_user:hcb_secure_password@localhost:5432/hcb_monitor

# Redis
REDIS_URL=redis://localhost:6379/0

# Polymarket API
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Polling intervals (seconds)
POLL_INTERVAL_TRADES=30
POLL_INTERVAL_MARKETS=300

# Anomaly detection schedule (hours)
ANOMALY_DETECT_INTERVAL_HOURS=6

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_FROM_EMAIL=hcb-monitor@example.com
ALERT_TO_EMAILS=admin@example.com

# Telegram notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Alert rate limiting (minutes between same wallet+rule alerts)
ALERT_RATE_LIMIT_MINUTES=60
